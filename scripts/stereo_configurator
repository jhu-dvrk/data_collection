#!/usr/bin/env python3

import argparse
import sys
import termios
import tty
import select
from dataclasses import dataclass

import cv2
import numpy as np


# Key code maps for terminal input.
KEY_UP = "UP"
KEY_DOWN = "DOWN"
KEY_LEFT = "LEFT"
KEY_RIGHT = "RIGHT"
KEY_PLUS = "+"
KEY_MINUS = "-"
KEY_QUIT = "q"
KEY_FULLSCREEN = "f"


class TerminalInput:
    def __init__(self):
        self.old_settings = termios.tcgetattr(sys.stdin)

    def __enter__(self):
        tty.setcbreak(sys.stdin.fileno())
        return self

    def __exit__(self, type, value, traceback):
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.old_settings)

    def get_key(self):
        if select.select([sys.stdin], [], [], 0)[0]:
            ch = sys.stdin.read(1)
            if ch == "\x1b":  # Escape sequence
                ch2 = sys.stdin.read(1)
                if ch2 == "[":
                    ch3 = sys.stdin.read(1)
                    if ch3 == "A": return KEY_UP
                    if ch3 == "B": return KEY_DOWN
                    if ch3 == "C": return KEY_RIGHT
                    if ch3 == "D": return KEY_LEFT
                return None
            if ch in ("q", "\x1b"): return KEY_QUIT
            if ch in ("f", "F"): return KEY_FULLSCREEN
            if ch in ("+", "="): return KEY_PLUS
            if ch in ("-", "_"): return KEY_MINUS
        return None


def clip_int(value: int, min_value: int, max_value: int) -> int:
    return max(min_value, min(max_value, value))


@dataclass
class CropValues:
    left: int
    right: int
    top: int
    bottom: int


def compute_center_crop(src_w: int, src_h: int, dst_w: int, dst_h: int) -> CropValues:
    crop_x_total = max(0, src_w - dst_w)
    crop_y_total = max(0, src_h - dst_h)

    left_crop = crop_x_total // 2
    right_crop = crop_x_total - left_crop
    top_crop = crop_y_total // 2
    bottom_crop = crop_y_total - top_crop

    return CropValues(left=left_crop, right=right_crop, top=top_crop, bottom=bottom_crop)


def compute_eye_size(working_w: int, working_h: int, resize_percent: int):
    eye_w = max(1, int(round(working_w * 100.0 / resize_percent)))
    eye_h = max(1, int(round(working_h * 100.0 / resize_percent)))
    return eye_w, eye_h

def compute_axis_starts(crop_total: int, offset_px: int) -> tuple[int, int]:
    center = crop_total // 2
    negative_start = center - int(np.floor(offset_px / 2.0))
    positive_start = center + int(np.ceil(offset_px / 2.0))
    return negative_start, positive_start


def compute_eye_crop(
    working_w: int,
    working_h: int,
    eye_w: int,
    eye_h: int,
    baseline_px: int,
    vertical_offset_px: int,
    sign: int,
) -> CropValues:
    crop_x_total = max(0, working_w - eye_w)
    crop_y_total = max(0, working_h - eye_h)

    left_start, right_start = compute_axis_starts(crop_x_total, baseline_px)
    top_start, bottom_start = compute_axis_starts(crop_y_total, vertical_offset_px)
    left_crop = left_start if sign < 0 else right_start
    right_crop = crop_x_total - left_crop

    top_crop = top_start if sign < 0 else bottom_start
    bottom_crop = crop_y_total - top_crop

    return CropValues(left=left_crop, right=right_crop, top=top_crop, bottom=bottom_crop)


def is_offset_valid(working_size: int, eye_size: int, offset_px: int) -> bool:
    min_offset, max_offset = offset_valid_range(working_size, eye_size)
    return min_offset <= offset_px <= max_offset


def clamp_offset_to_valid(working_size: int, eye_size: int, offset_px: int) -> int:
    min_offset, max_offset = offset_valid_range(working_size, eye_size)
    return clip_int(offset_px, min_offset, max_offset)


def offset_valid_range(working_size: int, eye_size: int):
    crop_total = max(0, working_size - eye_size)
    center = crop_total // 2

    min_half = -center
    max_half = crop_total - center

    # Ensure we stay 1px away from the absolute edge to avoid empty crops due to rounding
    min_offset = int(np.ceil(2.0 * min_half)) + 1
    max_offset = int(np.floor(2.0 * max_half)) - 1
    
    if min_offset > max_offset:
        return 0, 0
    return min_offset, max_offset


def crop_frame(frame: np.ndarray, crop: CropValues) -> np.ndarray:
    height, width = frame.shape[:2]
    x0 = crop.left
    x1 = width - crop.right
    y0 = crop.top
    y1 = height - crop.bottom
    return frame[y0:y1, x0:x1]


def as_preview_pipeline(source_snippet: str) -> str:
    snippet = source_snippet.strip()
    if "appsink" in snippet:
        return snippet
    return f"{snippet} ! videoconvert ! appsink drop=true sync=false"


def open_capture(source_label: str, source_snippet: str):
    pipeline = as_preview_pipeline(source_snippet)
    cap = cv2.VideoCapture(pipeline, cv2.CAP_GSTREAMER)
    if not cap.isOpened():
        raise RuntimeError(
            f"Unable to open {source_label} source with GStreamer backend. "
            f"Source must be a valid GStreamer snippet."
        )
    return cap


def build_stream_string(
    first_source: str,
    second_source: str,
    first_src_w: int,
    first_src_h: int,
    second_src_w: int,
    second_src_h: int,
    working_w: int,
    working_h: int,
    resize_percent: int,
    baseline_px: int,
    vertical_offset_px: int,
) -> str:
    eye_w, eye_h = compute_eye_size(working_w, working_h, resize_percent)

    first_normalize = compute_center_crop(first_src_w, first_src_h, working_w, working_h)
    second_normalize = compute_center_crop(second_src_w, second_src_h, working_w, working_h)

    left_zoom_crop = compute_eye_crop(working_w, working_h, eye_w, eye_h, baseline_px, vertical_offset_px, sign=-1)
    right_zoom_crop = compute_eye_crop(working_w, working_h, eye_w, eye_h, baseline_px, vertical_offset_px, sign=1)

    first_crop = CropValues(
        left=first_normalize.left + left_zoom_crop.left,
        right=first_normalize.right + left_zoom_crop.right,
        top=first_normalize.top + left_zoom_crop.top,
        bottom=first_normalize.bottom + left_zoom_crop.bottom,
    )
    second_crop = CropValues(
        left=second_normalize.left + right_zoom_crop.left,
        right=second_normalize.right + right_zoom_crop.right,
        top=second_normalize.top + right_zoom_crop.top,
        bottom=second_normalize.bottom + right_zoom_crop.bottom,
    )

    src_a = first_source
    src_b = second_source
    crop_a = first_crop
    crop_b = second_crop

    chain_a = (
        f"{src_a} ! queue ! videoconvert ! "
        f"videocrop left={crop_a.left} right={crop_a.right} top={crop_a.top} bottom={crop_a.bottom} ! mix.sink_0"
    )

    chain_b = (
        f"{src_b} ! queue ! videoconvert ! "
        f"videocrop left={crop_b.left} right={crop_b.right} top={crop_b.top} bottom={crop_b.bottom} ! mix.sink_1"
    )

    return (
        f"{chain_a} {chain_b} "
        f"compositor name=mix sink_0::xpos=0 sink_1::xpos={eye_w} ! "
        f"video/x-raw,width={2 * eye_w},height={eye_h}"
    )


def print_pipeline(
    stream: str,
    side_by_side: str,
    resize_percent: int,
    baseline_px: int,
    vertical_offset_px: int,
    working_w: int,
    working_h: int,
    eye_w: int,
    eye_h: int,
):
    print("\n--- stereo_configurator ---")
    print(f"side_by_side: {side_by_side}")
    print(f"working_size: {working_w}x{working_h}")
    print(f"eye_size: {eye_w}x{eye_h}")
    print(f"resize_percent: {resize_percent}")
    print(f"baseline_px: {baseline_px}")
    print(f"vertical_offset_px: {vertical_offset_px}")
    print("stream:")
    print(stream)


def key_matches(code: str, expected: str) -> bool:
    return code == expected


def set_fullscreen(window_name: str, enabled: bool):
    aspect_mode = cv2.WINDOW_FREERATIO if enabled else cv2.WINDOW_KEEPRATIO
    cv2.setWindowProperty(window_name, cv2.WND_PROP_ASPECT_RATIO, aspect_mode)
    mode = cv2.WINDOW_FULLSCREEN if enabled else cv2.WINDOW_NORMAL
    cv2.setWindowProperty(window_name, cv2.WND_PROP_FULLSCREEN, mode)


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Keyboard-only side-by-side stereo configurator for data_collection record. "
            "Uses OpenCV preview and prints a stream string for copy/paste into JSON config."
        )
    )
    parser.add_argument("-l", "--left", required=True, help="Left source GStreamer snippet")
    parser.add_argument("-r", "--right", required=True, help="Right source GStreamer snippet")
    args = parser.parse_args()

    first_gst = args.left.strip()
    second_gst = args.right.strip()
    if not first_gst or not second_gst:
        raise RuntimeError("Both --left and --right must be non-empty GStreamer snippets")

    first_cap = open_capture("left", first_gst)
    second_cap = open_capture("right", second_gst)

    ok_first, first_frame = first_cap.read()
    ok_second, second_frame = second_cap.read()
    if not ok_first or first_frame is None or not ok_second or second_frame is None:
        raise RuntimeError("Unable to read first frame from one or both sources")

    first_src_h, first_src_w = first_frame.shape[:2]
    second_src_h, second_src_w = second_frame.shape[:2]
    working_h = min(first_src_h, second_src_h)
    working_w = min(first_src_w, second_src_w)

    preview_fullscreen = False
    resize_percent = 100
    baseline_px = 0
    vertical_offset_px = 0
    window_name = "stereo_preview"
    overlay_window_name = "stereo_overlay"

    cv2.namedWindow(window_name, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO | cv2.WINDOW_GUI_NORMAL)
    cv2.resizeWindow(window_name, max(960, 2 * working_w), max(360, working_h))
    
    cv2.namedWindow(overlay_window_name, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO | cv2.WINDOW_GUI_NORMAL)
    cv2.resizeWindow(overlay_window_name, max(480, working_w), max(360, working_h))

    print(
        "Detected source frame sizes: "
        f"left={first_src_w}x{first_src_h}, right={second_src_w}x{second_src_h}, "
        f"working={working_w}x{working_h}"
    )

    eye_w, eye_h = compute_eye_size(working_w, working_h, resize_percent)
    stream_string = build_stream_string(
        first_gst,
        second_gst,
        first_src_w,
        first_src_h,
        second_src_w,
        second_src_h,
        working_w,
        working_h,
        resize_percent,
        baseline_px,
        vertical_offset_px,
    )
    side_by_side = "LR"

    with TerminalInput() as term:
        while True:
            ok_first, first_frame = first_cap.read()
            ok_second, second_frame = second_cap.read()

            if not ok_first or first_frame is None:
                first_cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
                ok_first, first_frame = first_cap.read()
            if not ok_second or second_frame is None:
                second_cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
                ok_second, second_frame = second_cap.read()
            if not ok_first or not ok_second or first_frame is None or second_frame is None:
                continue

            first_tile = crop_frame(first_frame, compute_center_crop(first_frame.shape[1], first_frame.shape[0], working_w, working_h))
            second_tile = crop_frame(second_frame, compute_center_crop(second_frame.shape[1], second_frame.shape[0], working_w, working_h))

            eye_w, eye_h = compute_eye_size(working_w, working_h, resize_percent)
            baseline_px = clamp_offset_to_valid(working_w, eye_w, baseline_px)
            vertical_offset_px = clamp_offset_to_valid(working_h, eye_h, vertical_offset_px)
            baseline_min, baseline_max = offset_valid_range(working_w, eye_w)
            vertical_min, vertical_max = offset_valid_range(working_h, eye_h)
            left_crop = compute_eye_crop(working_w, working_h, eye_w, eye_h, baseline_px, vertical_offset_px, sign=-1)
            right_crop = compute_eye_crop(working_w, working_h, eye_w, eye_h, baseline_px, vertical_offset_px, sign=1)

            first_out = crop_frame(first_tile, left_crop)
            second_out = crop_frame(second_tile, right_crop)

            if first_out.size == 0 or second_out.size == 0:
                print(f"[ERROR] Crop resulted in empty frame: left_out={first_out.shape}, right_out={second_out.shape}")
                continue

            preview = np.hstack([first_out, second_out])

            fullscreen_mode = "on" if preview_fullscreen else "off"
            info = (
                f"{side_by_side} | src:{working_w}x{working_h} | eye:{eye_w}x{eye_h} | resize:{resize_percent}% | baseline:{baseline_px}px | "
                f"vertical:{vertical_offset_px}px | fullscreen:{fullscreen_mode}"
            )
            baseline_info = (
                f"horizontal range: [{baseline_min}, {baseline_max}] px | "
                f"vertical range: [{vertical_min}, {vertical_max}] px"
            )
            controls = "+/-: resize (>100 enables offsets)  arrows: horizontal/vertical offset  f:fullscreen stretch  q/esc:quit"
            cv2.putText(preview, info, (10, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 255, 0), 2, cv2.LINE_AA)
            cv2.putText(preview, baseline_info, (10, 48), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 1, cv2.LINE_AA)
            cv2.putText(preview, controls, (10, 70), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 1, cv2.LINE_AA)

            # Labels for inputs, centered at bottom of each tile
            font = cv2.FONT_HERSHEY_SIMPLEX
            font_scale = 0.8
            thickness = 2
            
            left_size = cv2.getTextSize("left", font, font_scale, thickness)[0]
            right_size = cv2.getTextSize("right", font, font_scale, thickness)[0]
            
            left_x = (eye_w - left_size[0]) // 2
            right_x = eye_w + (eye_w - right_size[0]) // 2
            label_y = preview.shape[0] - 15

            cv2.putText(preview, "left", (left_x, label_y), font, font_scale, (0, 255, 255), thickness, cv2.LINE_AA)
            cv2.putText(preview, "right", (right_x, label_y), font, font_scale, (0, 255, 255), thickness, cv2.LINE_AA)

            display_frame = preview
            if preview_fullscreen:
                try:
                    _, _, win_w, win_h = cv2.getWindowImageRect(window_name)
                    if win_w > 0 and win_h > 0:
                        display_frame = cv2.resize(preview, (win_w, win_h), interpolation=cv2.INTER_LINEAR)
                except cv2.error:
                    pass

            cv2.imshow(window_name, display_frame)

            # --- Overlay Window (Superimposed) ---
            # Convert to grayscale
            gray1 = cv2.cvtColor(first_out, cv2.COLOR_BGR2GRAY)
            gray2 = cv2.cvtColor(second_out, cv2.COLOR_BGR2GRAY)
            
            # Convert back to BGR for color manipulation
            # Note: OpenCV BGR order
            bgr1 = cv2.cvtColor(gray1, cv2.COLOR_GRAY2BGR).astype(np.int16)
            bgr2 = cv2.cvtColor(gray2, cv2.COLOR_GRAY2BGR).astype(np.int16)
            
            # For one channel: add 40 to green (index 1)
            bgr1[:, :, 1] = np.clip(bgr1[:, :, 1] + 40, 0, 255)
            # For second channel: subtract 40 from green
            bgr2[:, :, 1] = np.clip(bgr2[:, :, 1] - 40, 0, 255)
            
            # Average of both transformed images
            overlay = ((bgr1 + bgr2) / 2).astype(np.uint8)
            
            cv2.putText(overlay, "OVERLAY VIEW", (10, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.65, (0, 0, 255), 2, cv2.LINE_AA)
            cv2.imshow(overlay_window_name, overlay)

            # Draw one frame per ~10ms. Need waitKey(1) for HighGUI updates.
            cv2.waitKey(1)
            key = term.get_key()
            changed = False

            if key == KEY_QUIT:
                break
            elif key == KEY_FULLSCREEN:
                preview_fullscreen = not preview_fullscreen
                set_fullscreen(window_name, preview_fullscreen)
                print(f"Fullscreen: {'ON' if preview_fullscreen else 'OFF'}")
            # Controls:
            #   +/-       -> resize crop rectangle
            #   Left/Right-> horizontal baseline shift
            #   Up/Down   -> vertical offset shift
            elif key == KEY_PLUS:
                updated_resize = clip_int(resize_percent + 1, 100, 200)
                changed = updated_resize != resize_percent
                resize_percent = updated_resize
                if changed: print(f"Size: {resize_percent}%")
            elif key == KEY_MINUS:
                updated_resize = clip_int(resize_percent - 1, 100, 200)
                changed = updated_resize != resize_percent
                resize_percent = updated_resize
                if changed: print(f"Size: {resize_percent}%")
            elif key == KEY_LEFT:
                updated_baseline = clamp_offset_to_valid(working_w, eye_w, baseline_px - 1)
                changed = updated_baseline != baseline_px
                baseline_px = updated_baseline
                if changed: print(f"Horizontal Shift: {baseline_px} px")
            elif key == KEY_RIGHT:
                updated_baseline = clamp_offset_to_valid(working_w, eye_w, baseline_px + 1)
                changed = updated_baseline != baseline_px
                baseline_px = updated_baseline
                if changed: print(f"Horizontal Shift: {baseline_px} px")
            elif key == KEY_UP:
                updated_vertical = clamp_offset_to_valid(working_h, eye_h, vertical_offset_px - 1)
                changed = updated_vertical != vertical_offset_px
                vertical_offset_px = updated_vertical
                if changed: print(f"Vertical Shift: {vertical_offset_px} px")
            elif key == KEY_DOWN:
                updated_vertical = clamp_offset_to_valid(working_h, eye_h, vertical_offset_px + 1)
                changed = updated_vertical != vertical_offset_px
                vertical_offset_px = updated_vertical
                if changed: print(f"Vertical Shift: {vertical_offset_px} px")

            if changed:
                eye_w, eye_h = compute_eye_size(working_w, working_h, resize_percent)
                baseline_px = clamp_offset_to_valid(working_w, eye_w, baseline_px)
                vertical_offset_px = clamp_offset_to_valid(working_h, eye_h, vertical_offset_px)
                stream_string = build_stream_string(
                    first_gst,
                    second_gst,
                    first_src_w,
                    first_src_h,
                    second_src_w,
                    second_src_h,
                    working_w,
                    working_h,
                    resize_percent,
                    baseline_px,
                    vertical_offset_px,
                )

    first_cap.release()
    second_cap.release()
    cv2.destroyAllWindows()

    print_pipeline(
        stream_string,
        side_by_side,
        resize_percent,
        baseline_px,
        vertical_offset_px,
        working_w,
        working_h,
        eye_w,
        eye_h,
    )

    print("\nFinal values for config:")
    print(f"side_by_side: {side_by_side}")
    print("stream:")
    print(stream_string)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
