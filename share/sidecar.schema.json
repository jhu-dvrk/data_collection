{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Video Sidecar Metadata",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "dc::sidecar@1.0.0"
      ]
    },
    "config_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_latency": {
      "type": "number"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cpu_ts": {
            "type": "integer"
          },
          "gst_ts": {
            "type": "integer"
          }
        },
        "required": [
          "cpu_ts",
          "gst_ts"
        ]
      }
    },
    "recording_start_cpu_ts": {
      "type": "integer"
    },
    "side_by_side": {
      "type": "string",
      "enum": ["undefined", "LR", "RL"],
      "description": "Indicates if the video contains a side-by-side stereo pair. 'LR' means left eye is on the left, 'RL' means right eye is on the left. 'undefined' means the video is not stereo or the layout is unknown."
    }
  },
  "required": [
    "frames"
  ]
}
