{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Video Sidecar Metadata",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "dc::sidecar@1.0.0"
      ]
    },
    "config_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimated_latency": {
      "type": "number"
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cpu_ts": {
            "type": "integer"
          },
          "gst_ts": {
            "type": "integer"
          }
        },
        "required": [
          "cpu_ts",
          "gst_ts"
        ]
      }
    },
    "recording_start_cpu_ts": {
      "type": "integer"
    }
  },
  "required": [
    "frames"
  ]
}
